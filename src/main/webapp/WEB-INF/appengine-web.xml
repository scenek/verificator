<?xml version="1.0" encoding="utf-8"?>
<appengine-web-app xmlns="http://appengine.google.com/ns/1.0">
	<application>${app.id}</application>
	<version>${app.version}</version>

	<threadsafe>true</threadsafe>
	<sessions-enabled>true</sessions-enabled>
	<runtime>java21</runtime>
	<!-- Required to keep legacy bundled services (Datastore, etc.) on java11+ runtimes -->
	<app-engine-apis>true</app-engine-apis>

	<system-properties>
		<property name="appengine.orm.disable.duplicate.emf.exception" value="true"/>
		<property name="java.util.logging.config.file" value="WEB-INF/logging.properties"/>
		<property name="recaptcha.sitekey" value="RECAPTCHA_SITEKEY_REMOVED"/>
		<property name="recaptcha.secretkey" value="RECAPTCHA_SECRETKEY_REMOVED"/>
	</system-properties>

</appengine-web-app>
